-- speed logic
local function currentSeat()
	local ch = player.Character
	local hum = ch and ch:FindFirstChildOfClass("Humanoid")
	return hum and hum.SeatPart
end

local braking = 0
local speedC = RunService.Heartbeat:Connect(function(dt)
	if not speedOn then return end
	local seat = currentSeat()
	if not seat then return end

	-- arrows (keyboard or on-screen pad): forward / back / strafe right / strafe left
	local fa, ra = 0, 0
	if pad.up or UIS:IsKeyDown(Enum.KeyCode.Up) then fa += 1 end
	if pad.down or UIS:IsKeyDown(Enum.KeyCode.Down) then fa -= 1 end
	if pad.right or UIS:IsKeyDown(Enum.KeyCode.Right) then ra += 1 end
	if pad.left or UIS:IsKeyDown(Enum.KeyCode.Left) then ra -= 1 end
	local arrows = (fa ~= 0 or ra ~= 0)

	-- normal throttle (W / S / stick) also gets the boosted speed
	local throttle = 0
	if seat:IsA("VehicleSeat") then
		seat.MaxSpeed = speedVal
		throttle = seat.ThrottleFloat
	else
		if UIS:IsKeyDown(Enum.KeyCode.W) then throttle += 1 end
		if UIS:IsKeyDown(Enum.KeyCode.S) then throttle -= 1 end
	end

	local root = seat.AssemblyRootPart or seat
	local cf = seat.CFrame
	local look = cf.LookVector * dirSign
	local right = cf.RightVector * dirSign
	look = Vector3.new(look.X, 0, look.Z)
	right = Vector3.new(right.X, 0, right.Z)
	if look.Magnitude < 0.01 then return end
	look = look.Unit
	right = right.Magnitude > 0.01 and right.Unit or Vector3.zero

	local move = look * math.clamp(fa + throttle, -1, 1) + right * ra
	if move.Magnitude > 1 then move = move.Unit end

	local v = root.AssemblyLinearVelocity
	local hv = Vector3.new(v.X, 0, v.Z)
	if move.Magnitude > 0.01 then
		if arrows then braking = 0.4 end
		local nv = hv:Lerp(move * speedVal, math.clamp(dt * 3, 0, 1))
		root.AssemblyLinearVelocity = Vector3.new(nv.X, v.Y, nv.Z)
	elseif braking > 0 then
		-- arrows released: stop smoothly instead of sliding away
		braking -= dt
		local nv = hv:Lerp(Vector3.zero, math.clamp(dt * 8, 0, 1))
		root.AssemblyLinearVelocity = Vector3.new(nv.X, v.Y, nv.Z)
	end
end)

