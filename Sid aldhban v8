-- ============================================================
-- MAIN SCRIPT (hitbox)
-- ============================================================
local function isDhab(n) return string.match(string.lower(n), "^dhab_%w+$") ~= nil end
local function nested(d)
	local p = d.Parent
	while p and p ~= workspace do
		if p:IsA("Model") and isDhab(p.Name) then return true end
		p = p.Parent
	end
	return false
end
local function register(d)
	if d:IsA("Model") and isDhab(d.Name) and not nested(d)
		and not (player.Character and d:IsDescendantOf(player.Character)) then
		models[d] = true
	end
end

local function rootPart(m)
	if m.PrimaryPart then return m.PrimaryPart end
	local best, bv = nil, -1
	for _, p in ipairs(m:GetDescendants()) do
		if p:IsA("BasePart") then
			local v = p.Size.X * p.Size.Y * p.Size.Z
			if v > bv then best, bv = p, v end
		end
	end
	return best
end

-- all parts of the dhab ordered from the front tip to the back
local function sortedParts(m)
	local cf, size = m:GetBoundingBox()
	local axis
	if size.X > size.Z then axis = cf.RightVector else axis = cf.LookVector end
	local dir = axis * (flip and -1 or 1)
	local list = {}
	for _, p in ipairs(m:GetDescendants()) do
		if p:IsA("BasePart") and p.Name ~= "HeadHB" then
			table.insert(list, { part = p, k = (p.Position - cf.Position):Dot(dir) })
		end
	end
	table.sort(list, function(a, b) return a.k > b.k end)
	local out = {}
	for i, e in ipairs(list) do out[i] = e.part end
	return out, size
end

local function clearMark(m)
	local mk = marks[m]
	if mk then mk.part:Destroy() marks[m] = nil end
end
local function clearAll() for m in pairs(marks) do clearMark(m) end end

local function build(m)
	clearMark(m)
	local parts, size = sortedParts(m)
	if #parts == 0 then return end
	local idx = math.clamp(selIdx, 1, #parts)
	local target = parts[idx]
	local p = Instance.new("Part")
	p.Name = "HeadHB"
	p.Size = Vector3.new(SIZE, SIZE, SIZE)
	p.Color, p.Transparency = COLOR, TRANSP
	p.Material = Enum.Material.SmoothPlastic
	p.CanCollide, p.Massless = false, true
	p.CanQuery, p.CanTouch = true, true
	p.Anchored = true
	-- offset stored relative to the selected part, re-applied every frame so it follows movement
	local pos = target.Position + Vector3.new(0, size.Y * up, 0)
	local off = CFrame.new(target.CFrame:PointToObjectSpace(pos))
	p.CFrame = target.CFrame * off
	-- outline the real body part the hitbox is attached to
	local hl = Instance.new("Highlight")
	hl.Adornee = target
	hl.FillTransparency = 1
	hl.OutlineColor = Color3.fromRGB(255, 230, 0)
	hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	hl.Parent = p
	p.Parent = m
	marks[m] = { part = p, root = target, off = off, name = target.Name, idx = idx, count = #parts }
end

local function rebuildAll()
	clearAll()
	if not enabled then return end
	for m in pairs(models) do if m.Parent then build(m) end end
end

